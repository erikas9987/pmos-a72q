# Reference: <https://postmarketos.org/devicepkg>
maintainer="Erikas Bitovtas <xerikasxx@gmail.com>"
pkgname=device-samsung-a72q
pkgdesc="Samsung Galaxy A72"
pkgver=9
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	make-dynpart-mappings
	mkbootimg
	linux-postmarketos-qcom-sm7125
	postmarketos-base
	swclock-offset
	soc-qcom-sm7125
	soc-qcom-sm7125-ucm
	systemd-boot
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	hexagonrpcd.confd
	modules-initfs
	81-libssc-samsung-a72q.rules
"

subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-nonfree-firmware-openrc:nonfree_firmware_openrc
	$pkgname-nonfree-firmware-udev:nonfree_firmware_udev
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/81-libssc-samsung-a72q.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-samsung-a72q.rules
	install -Dm644 "$srcdir"/hexagonrpcd.confd \
		"$pkgdir"/usr/share/hexagonrpcd/hexagonrpcd-adsp-sensorspd.conf
}

nonfree_firmware() {
	pkgdesc="GPU, venus, modem and sensor firmware"
	depends="
		firmware-samsung-a72q
		soc-qcom-sm7125-nonfree-firmware
		hexagonrpcd>=0.3.2-r3
	"

	amove usr/share/hexagonrpcd/hexagonrpcd-adsp-sensorspd.conf
}

nonfree_firmware_openrc() {
	install_if="$pkgname-nonfree-firmware=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="hexagonrpcd-openrc openrc"

	mkdir "$subpkgdir"
}

nonfree_firmware_udev() {
	default_udev
	install_if="$pkgname-nonfree-firmware=$pkgver-r$pkgrel udev"
}

